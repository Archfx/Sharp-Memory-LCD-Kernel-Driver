/dts-v1/;
/plugin/;

/ {
	compatible = "allwinner,sun50i-h618", "allwinner,sunxi";

	fragment@0 {
		target = <&spi0>;
		__overlay__ {
			status = "okay";

			spidev@0 {
				compatible = "spidev";
				reg = <0>; /* Chip select 0 */
				status = "disabled";
			};

			spidev@1 {
				compatible = "spidev";
				reg = <1>; /* Chip select 1 */
				status = "disabled";
			};
		};
	};

	fragment@1 {
		target = <&pio>;
		__overlay__ {
			spi0_pins: spi0_pins {
				pins = "PH7", "PH6"; /* SPI clock and MOSI for H618 */
				function = "spi"; /* SPI configuration */
			};
		};
	};

	fragment@2 {
		target = <&pio>;
		__overlay__ {
			sharp_pins: sharp_pins {
				pins = "PH6", "PH5"; /* Updated to the correct GPIOs for H618 */
				function = "output"; /* Configured as output pins */
			};
		};
	};

	fragment@3 {
		target = <&spi0>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			sharp: sharp@0 {
				compatible = "sharp";
				reg = <0>; /* SPI device on CS 0 */
				pinctrl-names = "default";
				pinctrl-0 = <&sharp_pins>;

				vcom-gpios = <&pio 7 6 0>; /* PH6 mapped to vcom */
				disp-gpios = <&pio 7 5 0>; /* PH5 mapped to display control */

				spi-cs-high;
				spi-max-frequency = <8000000>; /* Maximum SPI frequency */
				buswidth = <8>; /* 8-bit communication */
				debug = <0>;
			};
		};
	};
};
